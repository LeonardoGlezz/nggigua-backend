PORT=3000

# PostgreSQL (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nggigua_db
DB_USER=postgres
DB_PASSWORD=

# PostgreSQL (producción, ej. Neon). Si esta variable existe, database.js la
# usa en vez de las de arriba y se conecta con SSL automáticamente.
# Formato: postgresql://usuario:contrasena@host/basededatos?sslmode=require
DATABASE_URL=

# Cambia esto por un secreto largo y aleatorio en producción
# (por ejemplo: openssl rand -hex 32)
JWT_SECRET=

# URL(s) del frontend permitidas por CORS, separadas por coma si hay más de una.
# La primera de la lista también se usa para armar el link que llega en el
# correo de recuperación de contraseña (ej. https://tu-app.vercel.app).
FRONTEND_URL=http://localhost:5173

# Envío de correos de recuperación de contraseña vía Gmail + contraseña de
# aplicación (no la contraseña normal). Se genera en:
# myaccount.google.com/apppasswords (requiere verificación en 2 pasos
# activada en esa cuenta de Gmail).
EMAIL_USER=
EMAIL_PASS=
